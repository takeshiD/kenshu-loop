{
  "name": "kenshu-loop-dev",
  "description": "kenshu-loop スキルの開発用ハーネス（型検査・テスト）。配布物はスキルのディレクトリ skills/kenshu-loop/ だけ",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "postinstall": "node skills/kenshu-loop/scripts/kenshu-loop.mjs setup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/*.test.ts\"",
    "test:all": "npm test && npm run test:e2e",
    "test:unit": "node --test \"test/unit/*.test.ts\""
  },
  "devDependencies": {
    "@microsoft/tui-test": "0.1.1",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
