{
  "launch": { "argv": ["node", "todo.mjs"], "cols": 60, "rows": 12 },
  "steps": [
    { "do": "wait_text", "text": "項目がありません。a で追加できます" },
    { "do": "expect_text", "text": "?:ヘルプ", "row": 11 },
    { "do": "expect_cursor", "visible": false },
    { "do": "press", "keys": ["?"] },
    { "do": "wait_text", "text": "u: 削除を元に戻す" },
    { "do": "press", "keys": ["Escape"] },
    { "do": "wait_gone", "text": "操作一覧" },
    { "do": "press", "keys": ["a"] },
    { "do": "wait_text", "text": "追加>" },
    { "do": "expect_cursor", "visible": true, "y": 11 },
    { "do": "paste", "text": "来週の打ち合わせ資料を作成して、関係者全員にメールで共有する" },
    { "do": "press", "keys": ["Enter"] },
    { "do": "wait_text", "text": "追加しました" },
    { "do": "expect_text", "text": "[ ] 来週の打ち合わせ資料", "row": 1 },
    { "do": "expect_style", "text": "来週の打ち合わせ資料", "style": { "inverse": true } },
    { "do": "expect_style", "text": "TODO (1件)", "style": { "bold": true } },
    { "do": "resize", "cols": 30, "rows": 8 },
    { "do": "wait_text", "text": "…", "timeout_ms": 3000 },
    { "do": "expect_text", "text": "[ ] 来週の打ち合わせ資料を作…", "row": 1 },
    { "do": "capture", "name": "narrow" },
    { "do": "press", "keys": ["d"] },
    { "do": "wait_text", "text": "削除しました" },
    { "do": "expect_no_text", "text": "来週" },
    { "do": "press", "keys": ["u"] },
    { "do": "wait_text", "text": "元に戻しました" },
    { "do": "expect_text", "text": "来週", "row": 1 },
    { "do": "press", "keys": ["q"] },
    { "do": "wait_exit", "exit_code": 0 },
    { "do": "expect_file", "path": "$HOME/.todo-tui.json", "includes": ["来週の打ち合わせ資料を作成して、関係者全員にメールで共有する"] },
    { "do": "restart" },
    { "do": "wait_text", "text": "TODO (1件)" },
    { "do": "expect_text", "text": "来週", "row": 1 }
  ]
}
